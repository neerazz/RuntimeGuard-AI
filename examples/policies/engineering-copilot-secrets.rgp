runtimeguard-policy/v1
id=engineering-copilot-secrets
version=1

# Deployment: a coding assistant with repository context. Developers paste
# stack traces, environment fragments, and terminal output into prompts all
# day. Live credentials ride along, get transmitted to the model provider, and
# are then unrevocable-by-you: the only remedy is rotating the secret.
#
# These patterns match issuer-defined credential shapes, which is why they are
# blocks rather than escalations. A string in this shape is a credential.

# AWS long-lived (AKIA) and temporary (ASIA) access key IDs.
block aws-access-key-id \b(?:AKIA|ASIA)[0-9A-Z]{16}\b

# GitHub personal access, OAuth, user, server, and refresh tokens.
block github-token \bgh[opusr]_[A-Za-z0-9]{36,}\b

# Slack bot, user, app, refresh, and legacy tokens.
block slack-token \bxox[baprs]-[0-9A-Za-z-]{10,}\b

# Stripe live-mode secret keys. Test keys (sk_test_) are deliberately allowed.
block stripe-live-secret \bsk_live_[0-9A-Za-z]{16,}\b

# Any PEM private key block, pasted from a keyfile or a failing TLS handshake.
block private-key-block -----BEGIN (?:RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY-----

# A bearer token copied out of a request log or curl invocation.
block bearer-token (?i)authorization:[ \t]*bearer[ \t]+[A-Za-z0-9._~+/-]{20,}

# Env-file lines are context a developer often genuinely needs help with, so
# route them to a human rather than blocking the whole prompt.
escalate env-assignment (?im)^[ \t]*[A-Z][A-Z0-9_]{2,}_(?:SECRET|TOKEN|PASSWORD|PASSWD|APIKEY|API_KEY|PRIVATE_KEY)[ \t]*=[ \t]*\S+

# Connection strings with inline credentials.
escalate credentialed-dsn (?i)\b(?:postgres(?:ql)?|mysql|mongodb(?:\+srv)?|redis|amqp)://[^:\s/]+:[^@\s]+@\S+
